#!/bin/sh

set -e

_RUN_TS=$(date +%Y-%m-%d_%H-%M-%S)


# 1. Check code formatting on staged files (auto-fix if needed)
printf "  ✓ check-format-staged... "
if make check-format-staged > /dev/null 2>&1; then
  printf "ok\n"
else
  printf "auto-formatting staged files... "
  # Avoid git add -u to prevent staging unstaged hunks/working-tree modifications
  _STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)
  make fix-format-staged > /dev/null 2>&1
  if [ -n "$_STAGED_FILES" ]; then
    echo "$_STAGED_FILES" | xargs git add
  fi
  printf "fixed & re-staged\n"
fi

# 2. Run validations on affected workspaces (fail-fast on first error)
run_step() {
  NAME=$1
  CMD=$2
  printf "  ✓ %s... " "$NAME"
  TMPFILE="/tmp/myself-precommit-${_RUN_TS}-${NAME}.log"
  if eval "$CMD" > "$TMPFILE" 2>&1; then
    printf "ok\n"
    rm -f "$TMPFILE"
  else
    EXIT_CODE=$?
    printf "FAILED (exit %d)\n" "$EXIT_CODE"
    cat "$TMPFILE"
    echo "\nℹ️  Inspect logs anytime with: make precommit-logs"
    exit 1
  fi
}

run_step "check-affected" "make check-affected"

echo "  ✓ All pre-commit checks passed successfully."
exit 0
