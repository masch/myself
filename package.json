{
  "name": "myself-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "turbo": "^2.4.4",
    "typescript": "~6.0.3"
  }
}
